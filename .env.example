# Optional root-level Compose defaults for local runs.
# Copy to a gitignored `.env` next to compose.yaml (Compose auto-loads it for interpolation).
#
# Keep COMPOSE_PROJECT_NAME=fetchnow so logical volumes resolve to the existing
# Docker volume names fetchnow_pgdata / fetchnow_tmp after PRD1A (no explicit name:).

COMPOSE_PROJECT_NAME=fetchnow

# Development image tag / OCI revision label (default). Staging must use a full SHA.
FETCHNOW_RELEASE_REVISION=local

POSTGRES_DB=fetchnow
POSTGRES_USER=fetchnow
POSTGRES_PASSWORD=fetchnow
# Local gateway publish comes from compose.override.yaml (host 8080).
# GATEWAY_PORT is used by staging/prod fragments when override is not loaded.
GATEWAY_PORT=80
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_SITE_URL=http://localhost:8080

ABUSE_CONTACT_EMAIL=

API_CONCURRENCY_LIMIT=32
WORKER_CONCURRENCY=2
METADATA_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=5

MAX_SOURCE_DURATION_SECONDS=3600
MAX_SOURCE_FILE_BYTES=536870912
MAX_OUTPUT_FILE_BYTES=536870912

TEMP_STORAGE_MAX_BYTES=10737418240
TEMP_STORAGE_SOFT_LIMIT_BYTES=8589934592
MIN_FREE_DISK_BYTES=1073741824

JOB_ABSOLUTE_TTL_SECONDS=3600
READY_FILE_TTL_SECONDS=900

# URL validation (PR1)
URL_ALLOWED_SCHEMES=http,https
URL_ALLOWED_PORTS=80,443
URL_MAX_LENGTH=4096
URL_MAX_REDIRECTS=5
DNS_RESOLUTION_TIMEOUT_SECONDS=3
PROVIDER_VK_ENABLED=true
PROVIDER_RUTUBE_ENABLED=true

# Safe outbound HTTP (PR2)
OUTBOUND_CONNECT_TIMEOUT_SECONDS=5
OUTBOUND_READ_TIMEOUT_SECONDS=10
OUTBOUND_TOTAL_TIMEOUT_SECONDS=15
OUTBOUND_MAX_RESPONSE_BYTES=1048576
OUTBOUND_PROBE_BODY_BYTES=131072
OUTBOUND_USER_AGENT=FetchNow/1.0
OUTBOUND_ALLOWED_CONTENT_TYPES=text/html,application/json,text/plain

# Wrapper resolution foundation (PR3A) — no production wrappers yet
WRAPPER_RESOLUTION_MAX_DEPTH=3
