# Staging Compose contract example for FetchNow (PRD1A).
# Copy to gitignored `.env.staging` and replace placeholders before use:
#   cp .env.staging.example .env.staging
#
# Launch (never omit --project-name / file list — avoids compose.override.yaml):
#   docker compose --env-file .env.staging --project-name fetchnow-staging \
#     -f compose.yaml -f compose.staging.yaml up -d --build
#
# COMPOSE_PROJECT_NAME is documented here for operators; always also pass
# --project-name explicitly so CWD name cannot silently change isolation.

COMPOSE_PROJECT_NAME=fetchnow-staging

# Loopback-only gateway publish (host Nginx terminates TLS later in PRD1B).
GATEWAY_PORT=127.0.0.1:8091

APP_ENV=staging
LOG_LEVEL=INFO
PUBLIC_SITE_URL=https://staging.fetchnow.online

POSTGRES_DB=fetchnow
POSTGRES_USER=fetchnow
POSTGRES_PASSWORD=replace-with-unique-staging-password

ABUSE_CONTACT_EMAIL=

API_CONCURRENCY_LIMIT=32
WORKER_CONCURRENCY=2
METADATA_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=5

MAX_SOURCE_DURATION_SECONDS=3600
MAX_SOURCE_FILE_BYTES=536870912
MAX_OUTPUT_FILE_BYTES=536870912

TEMP_STORAGE_MAX_BYTES=10737418240
TEMP_STORAGE_SOFT_LIMIT_BYTES=8589934592
MIN_FREE_DISK_BYTES=1073741824

JOB_ABSOLUTE_TTL_SECONDS=3600
READY_FILE_TTL_SECONDS=900

URL_ALLOWED_SCHEMES=http,https
URL_ALLOWED_PORTS=80,443
URL_MAX_LENGTH=4096
URL_MAX_REDIRECTS=5
DNS_RESOLUTION_TIMEOUT_SECONDS=3
PROVIDER_VK_ENABLED=true
PROVIDER_RUTUBE_ENABLED=true

OUTBOUND_CONNECT_TIMEOUT_SECONDS=5
OUTBOUND_READ_TIMEOUT_SECONDS=10
OUTBOUND_TOTAL_TIMEOUT_SECONDS=15
OUTBOUND_MAX_RESPONSE_BYTES=1048576
OUTBOUND_PROBE_BODY_BYTES=131072
OUTBOUND_USER_AGENT=FetchNow/1.0
OUTBOUND_ALLOWED_CONTENT_TYPES=text/html,application/json,text/plain
