# FetchNow backend environment template.
# Copy to .env for local non-Compose runs. Compose injects these via compose files.

APP_NAME=FetchNow
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (async SQLAlchemy URL)
DATABASE_URL=postgresql+asyncpg://fetchnow:fetchnow@localhost:5432/fetchnow

# Abuse / rights contact (leave empty until a real mailbox is provisioned)
ABUSE_CONTACT_EMAIL=

# Worker lifecycle
WORKER_POLL_INTERVAL_SECONDS=5

# Concurrency (future job / metadata processing — env-driven, not hardcoded in domain logic)
API_CONCURRENCY_LIMIT=32
WORKER_CONCURRENCY=2
METADATA_CONCURRENCY=4

# Source / output limits (development-safe defaults; tighten in production)
MAX_SOURCE_DURATION_SECONDS=3600
MAX_SOURCE_FILE_BYTES=536870912
MAX_OUTPUT_FILE_BYTES=536870912

# Temporary storage
TEMP_STORAGE_PATH=/var/lib/fetchnow/tmp
TEMP_STORAGE_MAX_BYTES=10737418240
TEMP_STORAGE_SOFT_LIMIT_BYTES=8589934592
MIN_FREE_DISK_BYTES=1073741824

# Job / file TTL
JOB_ABSOLUTE_TTL_SECONDS=3600
READY_FILE_TTL_SECONDS=900

# URL validation (PR1)
URL_ALLOWED_SCHEMES=http,https
URL_ALLOWED_PORTS=80,443
URL_MAX_LENGTH=4096
URL_MAX_REDIRECTS=5
DNS_RESOLUTION_TIMEOUT_SECONDS=3
PROVIDER_VK_ENABLED=true
PROVIDER_RUTUBE_ENABLED=true

# Safe outbound HTTP (PR2)
OUTBOUND_CONNECT_TIMEOUT_SECONDS=5
OUTBOUND_READ_TIMEOUT_SECONDS=10
OUTBOUND_TOTAL_TIMEOUT_SECONDS=15
OUTBOUND_MAX_RESPONSE_BYTES=1048576
OUTBOUND_PROBE_BODY_BYTES=131072
OUTBOUND_USER_AGENT=FetchNow/1.0
OUTBOUND_ALLOWED_CONTENT_TYPES=text/html,application/json,text/plain

# Wrapper resolution foundation (PR3A) — production wrappers: Yandex Preview
WRAPPER_RESOLUTION_MAX_DEPTH=3

# Media inspection foundation (PR4) — metadata only; disabled by default.
# For local worker runs that enable inspection, set an absolute yt-dlp path.
MEDIA_INSPECTION_ENABLED=false
MEDIA_INSPECTION_YTDLP_PATH=
MEDIA_INSPECTION_TIMEOUT_SECONDS=30
MEDIA_INSPECTION_SOCKET_TIMEOUT_SECONDS=10
MEDIA_INSPECTION_STDOUT_MAX_BYTES=1048576
MEDIA_INSPECTION_STDERR_MAX_BYTES=262144
MEDIA_INSPECTION_MAX_FORMATS=32
MEDIA_INSPECTION_MAX_TITLE_LENGTH=200
MEDIA_INSPECTION_MAX_HEIGHT=2160
MEDIA_INSPECTION_MAX_WIDTH=3840
MEDIA_INSPECTION_JSON_MAX_DEPTH=12
MEDIA_INSPECTION_JSON_MAX_NODES=8192
MEDIA_INSPECTION_MAX_FORMAT_ENTRIES=256
MEDIA_INSPECTION_TEMP_ROOT=

# Durable media-inspection jobs (PR5) — disabled by default.
MEDIA_JOBS_ENABLED=false
MEDIA_JOB_LEASE_SECONDS=60
MEDIA_JOB_SHUTDOWN_GRACE_SECONDS=15
MEDIA_JOB_MAX_ATTEMPTS=3
MEDIA_JOB_RETRY_BASE_SECONDS=2
MEDIA_JOB_RETRY_MAX_SECONDS=60
MEDIA_JOB_ABSOLUTE_TTL_SECONDS=86400
MEDIA_JOB_RESULT_MAX_BYTES=65536

# Durable download execution (PR6) — disabled by default; no client file delivery.
# MEDIA_DOWNLOAD_CONCURRENCY must be exactly 1 (Settings rejects other values).
MEDIA_DOWNLOADS_ENABLED=false
MEDIA_DOWNLOAD_ARTIFACT_TTL_SECONDS=3600
MEDIA_DOWNLOAD_MAX_ATTEMPTS=3
MEDIA_DOWNLOAD_TEMP_ROOT=
MEDIA_DOWNLOAD_CONCURRENCY=1
MEDIA_DOWNLOAD_MAX_BYTES=536870912
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=120
MEDIA_DOWNLOAD_SOCKET_TIMEOUT_SECONDS=30
MEDIA_DOWNLOAD_MIN_FREE_BYTES=2147483648
MEDIA_DOWNLOAD_STDOUT_MAX_BYTES=1048576
MEDIA_DOWNLOAD_STDERR_MAX_BYTES=262144
MEDIA_DOWNLOAD_RETRY_BASE_SECONDS=2
MEDIA_DOWNLOAD_RETRY_MAX_SECONDS=60
# MEDIA_DOWNLOAD_ORPHAN_GRACE_SECONDS must be >= 60: reconciliation must not
# delete a publication a peer worker has not yet committed as ready.
MEDIA_DOWNLOAD_ORPHAN_GRACE_SECONDS=300
MEDIA_DOWNLOAD_LEASE_SECONDS=120
