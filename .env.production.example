# Production Compose contract example for FetchNow (PRD1D-A).
# Copy to gitignored `.env.production` on the production host only and replace
# placeholders before use:
#   cp .env.production.example /srv/fetchnow-production/env/.env.production
#   chmod 600 /srv/fetchnow-production/env/.env.production
#
# Never commit a real `.env.production`. Never copy staging secrets here.
#
# Launch (never omit --project-name / file list — avoids compose.override.yaml):
#   docker compose --env-file .env.production --project-name fetchnow-production \
#     -f compose.yaml -f compose.production.yaml <command>
#
# Release Make/CLI remain staging-shaped until PRD1D-B. This file documents
# the production env contract; it is not a deploy entry point by itself.
#
# COMPOSE_PROJECT_NAME is documented here for operators; always also pass
# --project-name explicitly so CWD name cannot silently change isolation.

COMPOSE_PROJECT_NAME=fetchnow-production

# Full lowercase 40-character Git SHA for all application images (api/worker/web/gateway).
# Never use abbreviated SHAs, branch names, or "latest". Replace this placeholder.
FETCHNOW_RELEASE_REVISION=0000000000000000000000000000000000000000

# Loopback-only gateway publish (host Nginx terminates TLS on :443).
GATEWAY_PORT=127.0.0.1:8091

APP_ENV=production
LOG_LEVEL=INFO
PUBLIC_SITE_URL=https://fetchnow.online
# Browser media flow (PR8). Keep false unless jobs+inspection+downloads+delivery
# are also explicitly enabled by the operator. Independent of staging.
PUBLIC_MEDIA_FLOW_ENABLED=false
# Search indexing is an explicit operator choice. Keep false until official
# launch. Production Compose interpolates this value (staging hard-codes false).
PUBLIC_SEARCH_INDEXING_ENABLED=false

POSTGRES_DB=fetchnow
POSTGRES_USER=fetchnow
# URL-safe only: A-Z a-z 0-9 . _ ~ - ; length >= 32. No @ / : % whitespace quotes.
# Distinct from the staging placeholder. Never reuse the staging password.
POSTGRES_PASSWORD=replace-with-32plus-url-safe-production-password

# Operator paths consumed by release preflight (not written by this file).
FETCHNOW_DEPLOY_ROOT=/srv/fetchnow-production
FETCHNOW_BACKUP_ROOT=/srv/fetchnow-production/backups

ABUSE_CONTACT_EMAIL=

API_CONCURRENCY_LIMIT=32
WORKER_CONCURRENCY=2
METADATA_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=5

MAX_SOURCE_DURATION_SECONDS=7200
MAX_SOURCE_FILE_BYTES=3221225472
MAX_OUTPUT_FILE_BYTES=3221225472

TEMP_STORAGE_MAX_BYTES=10737418240
TEMP_STORAGE_SOFT_LIMIT_BYTES=8589934592
MIN_FREE_DISK_BYTES=1073741824

JOB_ABSOLUTE_TTL_SECONDS=3600
READY_FILE_TTL_SECONDS=900

URL_ALLOWED_SCHEMES=http,https
URL_ALLOWED_PORTS=80,443
URL_MAX_LENGTH=4096
URL_MAX_REDIRECTS=5
DNS_RESOLUTION_TIMEOUT_SECONDS=3
PROVIDER_VK_ENABLED=true
PROVIDER_RUTUBE_ENABLED=true
PROVIDER_OK_ENABLED=true
PROVIDER_DZEN_ENABLED=true

OUTBOUND_CONNECT_TIMEOUT_SECONDS=5
OUTBOUND_READ_TIMEOUT_SECONDS=10
OUTBOUND_TOTAL_TIMEOUT_SECONDS=15
OUTBOUND_MAX_RESPONSE_BYTES=1048576
OUTBOUND_PROBE_BODY_BYTES=131072
OUTBOUND_USER_AGENT=FetchNow/1.0
OUTBOUND_ALLOWED_CONTENT_TYPES=text/html,application/json,text/plain

# Wrapper resolution foundation (PR3A/PR3B)
WRAPPER_RESOLUTION_MAX_DEPTH=3

# Media inspection foundation (PR4) — metadata only; keep disabled until
# explicitly enabled by the operator with a trusted absolute yt-dlp path.
MEDIA_INSPECTION_ENABLED=false
MEDIA_INSPECTION_YTDLP_PATH=
MEDIA_INSPECTION_TIMEOUT_SECONDS=30
MEDIA_INSPECTION_SOCKET_TIMEOUT_SECONDS=10
MEDIA_INSPECTION_STDOUT_MAX_BYTES=1048576
MEDIA_INSPECTION_STDERR_MAX_BYTES=262144
MEDIA_INSPECTION_MAX_FORMATS=32
MEDIA_INSPECTION_MAX_TITLE_LENGTH=200
MEDIA_INSPECTION_MAX_HEIGHT=2160
MEDIA_INSPECTION_MAX_WIDTH=3840
MEDIA_INSPECTION_JSON_MAX_DEPTH=12
MEDIA_INSPECTION_JSON_MAX_NODES=8192
MEDIA_INSPECTION_MAX_FORMAT_ENTRIES=256
MEDIA_INSPECTION_TEMP_ROOT=

# Durable media-inspection jobs (PR5) — leave disabled until explicitly enabled.
MEDIA_JOBS_ENABLED=false
MEDIA_JOB_LEASE_SECONDS=60
MEDIA_JOB_SHUTDOWN_GRACE_SECONDS=15
MEDIA_JOB_MAX_ATTEMPTS=3
MEDIA_JOB_RETRY_BASE_SECONDS=2
MEDIA_JOB_RETRY_MAX_SECONDS=60
MEDIA_JOB_ABSOLUTE_TTL_SECONDS=86400
MEDIA_JOB_RESULT_MAX_BYTES=65536

# Durable download execution (PR6) — keep disabled unless explicitly approved.
# Do not set MEDIA_DOWNLOAD_TEMP_ROOT on API; worker Compose declares it.
# MEDIA_DOWNLOAD_CONCURRENCY must remain exactly 1.
MEDIA_DOWNLOADS_ENABLED=false
MEDIA_DOWNLOAD_ARTIFACT_TTL_SECONDS=3600
MEDIA_DOWNLOAD_MAX_ATTEMPTS=3
MEDIA_DOWNLOAD_TEMP_ROOT=
MEDIA_DOWNLOAD_CONCURRENCY=1
MEDIA_DOWNLOAD_MAX_BYTES=3221225472
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=300
MEDIA_DOWNLOAD_SOCKET_TIMEOUT_SECONDS=30
MEDIA_DOWNLOAD_MIN_FREE_BYTES=2147483648
MEDIA_DOWNLOAD_STDOUT_MAX_BYTES=1048576
MEDIA_DOWNLOAD_STDERR_MAX_BYTES=262144
MEDIA_DOWNLOAD_RETRY_BASE_SECONDS=2
MEDIA_DOWNLOAD_RETRY_MAX_SECONDS=60
# MEDIA_DOWNLOAD_ORPHAN_GRACE_SECONDS must be >= 60: reconciliation must not
# delete a publication a peer worker has not yet committed as ready.
MEDIA_DOWNLOAD_ORPHAN_GRACE_SECONDS=300
MEDIA_DOWNLOAD_LEASE_SECONDS=120

# Authenticated private artifact delivery (PR7) — disabled by default.
# Dedicated delivery process only. API must not receive MEDIA_DELIVERY_ROOT.
MEDIA_DELIVERY_ENABLED=false
MEDIA_DELIVERY_ROOT=
MEDIA_DELIVERY_CHUNK_BYTES=65536
MEDIA_DELIVERY_CONCURRENCY=8
MEDIA_DELIVERY_RANGE_ENABLED=true

# Browser-native delivery grants (PR14) — disabled by default.
# Enable only with MEDIA_DELIVERY_ENABLED=true behind HTTPS.
MEDIA_BROWSER_DELIVERY_ENABLED=false
MEDIA_BROWSER_GRANT_TTL_SECONDS=300
MEDIA_BROWSER_GRANT_MAX_ACTIVE=4

# Bounded stream-copy muxing (PR9) — disabled by default. Worker-only tool paths.
MEDIA_MUXING_ENABLED=false
MEDIA_MUXING_FFMPEG_PATH=
MEDIA_MUXING_FFPROBE_PATH=
MEDIA_MUXING_TIMEOUT_SECONDS=90
MEDIA_MUXING_MAX_STDOUT_BYTES=262144
MEDIA_MUXING_MAX_STDERR_BYTES=262144
MEDIA_MUXING_DURATION_TOLERANCE_SECONDS=2
MEDIA_MUXING_MAX_VIDEO_CANDIDATES=8
MEDIA_MUXING_MAX_AUDIO_CANDIDATES=8
MEDIA_MUXING_MAX_DERIVED_OPTIONS=8
