---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const siteUrl = (import.meta.env.PUBLIC_SITE_URL ?? "http://localhost").replace(
  /\/$/,
  "",
);
const { title = "FetchNow", description = "Paste a link. Fetch the media. Done." } =
  Astro.props;
const canonical = `${siteUrl}/`;
const ogImage = `${siteUrl}/og.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FetchNow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:alt" content="FetchNow" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <slot />
  </body>
</html>
