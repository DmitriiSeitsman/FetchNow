---
/**
 * Site-wide footer: legal links, contacts, and self-employed requisites.
 */
import { merchant } from "../lib/legal/merchant";

const infoLinks = [
  { href: "/premium/", label: "Premium" },
  { href: "/offer/", label: "Проект оферты" },
  { href: "/terms/", label: "Условия использования" },
  { href: "/copyright/", label: "Правообладателям" },
  { href: "/privacy/", label: "Политика конфиденциальности" },
] as const;

const contactLinks = [
  {
    href: `mailto:${merchant.supportEmail}`,
    label: "Поддержка",
    detail: merchant.supportEmail,
  },
  {
    href: `tel:${merchant.phoneTel}`,
    label: "Телефон",
    detail: merchant.phoneDisplay,
  },
  {
    href: `mailto:${merchant.copyrightEmail}`,
    label: "Правообладателям",
    detail: merchant.copyrightEmail,
  },
] as const;
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <section class="site-footer-col site-footer-col--requisites" aria-labelledby="footer-requisites-heading">
      <h2 id="footer-requisites-heading" class="site-footer-heading">Реквизиты</h2>
      <p class="site-footer-requisites">
        <span class="site-footer-requisites-line">
          {merchant.statusLabel}
          {" "}
          {merchant.fullName}
        </span>
        <span class="site-footer-requisites-line">ИНН {merchant.inn}</span>
        <span class="site-footer-requisites-line">{merchant.location}</span>
        <a class="site-footer-requisites-line" href={`mailto:${merchant.supportEmail}`}>
          {merchant.supportEmail}
        </a>
        <a class="site-footer-requisites-line" href={`tel:${merchant.phoneTel}`}>
          {merchant.phoneDisplay}
        </a>
      </p>
    </section>
    <nav class="site-footer-col" aria-labelledby="footer-info-heading">
      <h2 id="footer-info-heading" class="site-footer-heading">Информация</h2>
      <ul class="site-footer-list">
        {
          infoLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav class="site-footer-col" aria-labelledby="footer-contacts-heading">
      <h2 id="footer-contacts-heading" class="site-footer-heading">Контакты</h2>
      <ul class="site-footer-list">
        {
          contactLinks.map((link) => (
            <li>
              <a href={link.href}>
                <span class="site-footer-contact-label">{link.label}</span>
                <span class="site-footer-contact-email">{link.detail}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
