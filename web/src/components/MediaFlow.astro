---
import { isMediaFlowEnabled } from "../lib/media-flow/flag";
import ProviderSupport from "./ProviderSupport.astro";

const enabled = isMediaFlowEnabled();
---

<section class="flow" data-media-flow>
  <form class="flow-form" data-flow-form>
    <div class="field">
      <label class="field-label" for="media-link">Ссылка на видео</label>
      <div class="field-control">
        <input
          class="field-input field-input-live field-input-with-action"
          id="media-link"
          data-flow-url
          type="url"
          name="url"
          inputmode="url"
          autocomplete="url"
          placeholder="https://…"
          required
          disabled={!enabled}
          aria-disabled={enabled ? "false" : "true"}
          aria-describedby="flow-hint"
        />
        <button
          class="btn-paste"
          type="button"
          data-flow-paste
          disabled={!enabled}
          aria-label="Вставить ссылку из буфера обмена"
          title="Вставить"
        >
          <svg
            class="btn-paste-icon"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            aria-hidden="true"
            focusable="false"
          >
            <rect
              x="8"
              y="2"
              width="8"
              height="4"
              rx="1"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            ></rect>
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
            ></path>
          </svg>
        </button>
      </div>
      <p class="hint field-hint" data-flow-paste-hint role="status" aria-live="polite" hidden></p>
    </div>
    <div class="flow-submit-row">
      <button
        class="btn btn-primary"
        type="submit"
        data-flow-submit
        disabled={!enabled}
      >
        Скачать
      </button>
      <button class="btn btn-ghost" type="button" data-flow-reset hidden>
        Начать сначала
      </button>
    </div>
  </form>
  <ProviderSupport id="flow-hint" />
  <p class="hint" data-flow-quota hidden></p>
  <p class="hint" data-flow-quota-reset hidden></p>
  <p class="premium-status" data-flow-premium-status role="status" aria-live="polite" hidden></p>
  <p class="status" data-flow-status aria-live="polite"></p>
  <p class="hint" data-flow-restored hidden>
    Восстановлена текущая задача скачивания.
  </p>
  <article class="meta-card" data-flow-meta hidden>
    <h2 class="meta-title" data-flow-title></h2>
    <p class="meta-line">
      <span data-flow-provider></span>
      <span aria-hidden="true"> · </span>
      <span data-flow-duration></span>
    </p>
  </article>
  <fieldset class="quality-card" data-flow-quality aria-labelledby="flow-quality-title" hidden>
    <h2 class="card-title" id="flow-quality-title">Выберите вариант скачивания</h2>
    <div class="quality-list" data-flow-formats hidden></div>
    <div class="premium-checkout" data-flow-premium-checkout hidden>
      <div class="premium-comparison" aria-label="Сравнение бесплатной загрузки и Premium">
        <section class="premium-plan premium-plan--free">
          <h3>Бесплатно</h3>
          <p data-flow-free-plan-quota>Лимит бесплатных загрузок</p>
          <p>С ограничением скорости FetchNow</p>
        </section>
        <section class="premium-plan premium-plan--premium">
          <h3>Premium · 24 часа</h3>
          <p>Без ограничения скорости со стороны FetchNow</p>
          <p>Без лимита бесплатных загрузок</p>
          <p>Отдельное видео и аудио, когда источник это поддерживает</p>
        </section>
      </div>
      <p class="premium-next-step" data-flow-premium-next-step>
        Premium снимает ограничения количества загрузок и скорости со стороны FetchNow.
      </p>
      <div class="premium-test-checkout" data-flow-premium-test-checkout hidden>
        <span class="test-badge">ТЕСТ</span>
        <p>Тестовый режим оплаты. Не является коммерческой покупкой.</p>
        <button class="btn btn-ghost" type="button" data-flow-premium-cta>
          Тестовая оплата Premium
        </button>
      </div>
    </div>
  </fieldset>
  <section class="progress-card" data-flow-progress data-tone="active" hidden>
    <div class="progress-head">
      <span class="loader" data-flow-loader hidden>
        <span class="spinner" data-flow-spinner aria-hidden="true"></span>
      </span>
      <p
        class="progress-stage"
        data-flow-progress-label
        role="status"
        aria-live="polite"
      >
      </p>
    </div>
    <div
      class="progress-track"
      data-flow-progress-bar
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      aria-valuetext="Ожидание начала…"
    >
      <span class="progress-fill" data-flow-progress-fill></span>
    </div>
    <p class="hint progress-note">
      Прогресс следует этапам подготовки. Проценты скачивания появляются, когда известен примерный размер.
    </p>
    <div class="progress-actions" data-flow-progress-actions hidden>
      <button class="btn btn-ghost" type="button" data-flow-cancel hidden>
        Отменить задачу
      </button>
    </div>
  </section>

  <section class="ready-choice" data-flow-ready hidden>
    <div class="ready-summary">
      <p class="ready-summary-badge" data-flow-ready-badge>✓ Готово к скачиванию</p>
      <p class="ready-summary-details" data-flow-ready-details></p>
    </div>
    <div class="ready-choice-grid">
      <article class="ready-card ready-card--free" data-flow-ready-free>
        <h3 class="ready-card-title">Бесплатно</h3>
        <div class="ready-card-body">
          <p class="ready-card-speed" data-flow-ready-speed hidden></p>
          <p class="ready-card-time" data-flow-ready-time hidden></p>
        </div>
        <div class="ready-card-actions">
          <button class="btn btn-primary" type="button" data-flow-save-as hidden>
            Сохранить как…
          </button>
          <a
            class="btn btn-primary"
            data-flow-native-download
            hidden
            download
          >
            Скачать бесплатно
          </a>
          <button class="btn btn-primary" type="button" data-flow-grant-retry hidden>
            Обновить доступ к скачиванию
          </button>
        </div>
      </article>
    </div>
  </section>

  <p class="hint" data-flow-mux hidden>
    Не удалось подготовить совместимый единый файл с видео и звуком без
    перекодирования.
  </p>
  <p class="hint" data-flow-https hidden>
    Откройте эту страницу по HTTPS, чтобы скачать подготовленный файл.
  </p>
  <p class="hint" data-flow-grant-pending hidden>
    Готовим безопасное скачивание…
  </p>
  <p class="hint" data-flow-handoff hidden>
    Отправлено в браузер
  </p>
  <div class="flow-actions">
    <p class="selection-summary" data-flow-selection-summary aria-live="polite" hidden></p>
    <button class="btn btn-primary" type="button" data-flow-download hidden>
      Подготовить скачивание
    </button>
  </div>
</section>

<script>
  import { mountMediaFlow } from "../lib/media-flow/bind";
  const root = document.querySelector("[data-media-flow]");
  if (root) {
    mountMediaFlow(root);
  }
</script>
