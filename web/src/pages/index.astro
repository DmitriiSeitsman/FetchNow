---
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaFlow from "../components/MediaFlow.astro";
import { isMediaFlowEnabled } from "../lib/media-flow/flag";

const enabled = isMediaFlowEnabled();
---

<BaseLayout>
  <main class="shell">
    <div class="atmosphere" aria-hidden="true"></div>
    <section class="hero">
      <p class="brand">FetchNow</p>
      <h1 class="tagline">Paste. Fetch. Done.</h1>
      <p class="lede">
        Drop a public media link and get a clean download path — no account, no clutter.
      </p>
      {
        enabled ? (
          <MediaFlow />
        ) : (
          <>
            <label class="field">
              <span class="field-label">Media link</span>
              <input
                class="field-input"
                type="url"
                placeholder="https://…"
                disabled
                aria-disabled="true"
                value=""
              />
            </label>
            <p class="hint">
              Fetching arrives in a later release. This is the foundation.
            </p>
          </>
        )
      }
    </section>
  </main>
</BaseLayout>
