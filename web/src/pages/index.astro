---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="shell">
    <div class="atmosphere" aria-hidden="true"></div>
    <section class="hero">
      <p class="brand">FetchNow</p>
      <h1 class="tagline">Paste. Fetch. Done.</h1>
      <p class="lede">
        Drop a public media link and get a clean download path — no account, no clutter.
      </p>
      <label class="field">
        <span class="field-label">Media link</span>
        <input
          class="field-input"
          type="url"
          placeholder="https://…"
          disabled
          aria-disabled="true"
          value=""
        />
      </label>
      <p class="hint">Fetching arrives in a later release. This is the foundation.</p>
    </section>
  </main>
</BaseLayout>
