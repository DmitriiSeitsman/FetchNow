---
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaFlow from "../components/MediaFlow.astro";
import ProviderSupport from "../components/ProviderSupport.astro";
import { isMediaFlowEnabled } from "../lib/media-flow/flag";
import {
  homePage,
  robotsContentForPage,
  websiteJsonLd,
  webApplicationJsonLd,
} from "../lib/seo/pages";

const enabled = isMediaFlowEnabled();
---

<BaseLayout
  title={homePage.title}
  description={homePage.description}
  canonicalPath={homePage.path}
  robots={robotsContentForPage(homePage.indexable)}
  jsonLd={[websiteJsonLd(), webApplicationJsonLd()]}
>
  <main class="shell">
    <div class="atmosphere" aria-hidden="true"></div>
    <section class="hero">
      <p class="brand">FetchNow</p>
      <h1 class="tagline">{homePage.h1}</h1>
      <p class="lede">{homePage.lede}</p>

      {
        enabled ? (
          <MediaFlow />
        ) : (
          <>
            <label class="field">
              <span class="field-label">Ссылка на видео</span>
              <input
                class="field-input"
                type="url"
                placeholder="https://…"
                disabled
                aria-disabled="true"
                value=""
              />
            </label>
            <p class="hint">
              Скачивание появится в следующем релизе. Сейчас это основа интерфейса.
            </p>
            <ProviderSupport />
          </>
        )
      }

      <div class="trust-premium">
        <p class="trust-line">Без рекламы. Вообще.</p>
        <p class="slogan">
          <span>Достаточно хорош, чтобы полюбить.</span>
          <span>Достаточно полезен, чтобы выбрать Premium.</span>
        </p>
      </div>
    </section>

    <section class="trust-points" aria-labelledby="trust-heading">
      <h2 id="trust-heading" class="trust-heading">Честный сервис для простой задачи</h2>
      <ul class="trust-grid">
        <li class="trust-item">
          <h3>Просто</h3>
          <p>Вставьте ссылку, выберите вариант и&nbsp;скачайте файл.</p>
        </li>
        <li class="trust-item">
          <h3>Честно</h3>
          <p>
            Понятные возможности бесплатного режима. Premium&nbsp;— только когда
            нужны дополнительные возможности.
          </p>
        </li>
        <li class="trust-item">
          <h3>Без рекламы</h3>
          <p>
            Никаких баннеров, всплывающих окон и&nbsp;фальшивых кнопок «Скачать».
          </p>
        </li>
      </ul>
    </section>
  </main>
</BaseLayout>
